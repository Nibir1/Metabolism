# Copy to .env (git-ignored, keep it mode 600) and fill in only what you use.
# Every command that sends anything to these services says so and needs
# -allow-remote.

# DeepSeek: hosted reflector, model judge, automated days (api.deepseek.com).
DEEPSEEK_API_KEY=

# TypeSafe's Jev: fast typed judging, through typesafe-go.
TYPESAFE_API_KEY=
